# Copy to .env and fill in. Every variable is validated at boot by
# src/config/env.ts — the server refuses to start if any are missing.

NODE_ENV=development
PORT=4000

# Where the browser app runs: CORS origin and OAuth redirect target.
FRONTEND_URL=http://localhost:3000
# This server's own public URL, used to build the OAuth callback.
API_URL=http://localhost:4000

# Cookie scope. Leave COOKIE_DOMAIN empty for localhost; in production set
# it to the domain shared by the app and API, e.g. .mergegate.com
# COOKIE_SAME_SITE=none is required when they sit on different domains,
# and itself requires HTTPS.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Datastores. `docker compose up -d` from the repo root starts both.
# Port 27018 avoids a Homebrew mongod that may already hold 27017.
MONGO_URL=mongodb://localhost:27018/pr-review?directConnection=true
REDIS_URL=redis://localhost:6379

# Signs session cookies. At least 32 characters.
#   openssl rand -hex 32
JWT_SECRET=

# Encrypts GitHub access tokens at rest. Exactly 64 hex characters.
# Losing this makes stored tokens unreadable; users must reconnect GitHub.
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL must be <API_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any string locally; must match the secret configured on the webhook.
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# Public URL GitHub posts webhooks to. localhost is unreachable from
# GitHub, so use a tunnel in development:
#   ngrok http 4000  ->  https://<id>.ngrok-free.app/webhooks/github
# Leave empty to skip webhook registration and run workflows manually.
GITHUB_WEBHOOK_URL=

# Powers the reviewer. https://console.groq.com/keys
GROQ_API_KEY=
# Optional override. List what your key can reach:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
